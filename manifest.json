{
  "manifest_version": 3,
  "name": "InstaHarvest — Local-First Profile Scraper",
  "version": "1.0.0",
  "description": "Collect a profile's posts, followers, comments, and likers — locally, in your browser. DOM-only, no account API, no cloud.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "sidePanel"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "InstaHarvest",
    "default_icon": {
      "16": "icons/Icon-16.png",
      "32": "icons/Icon-32.png",
      "48": "icons/Icon-48.png",
      "128": "icons/Icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "src/harvesters/*.js", "src/storage/*.js"],
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"]
    }
  ],
  "icons": {
    "16": "icons/Icon-16.png",
    "32": "icons/Icon-32.png",
    "48": "icons/Icon-48.png",
    "128": "icons/Icon-128.png"
  }
}
